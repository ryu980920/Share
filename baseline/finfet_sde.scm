;; =====================================================================
;;  TODO-RECESS : Source/Drain 영역을 리세스 식각으로 교체
;;
;;  원본 예제는 보통 평면(non-recessed) 또는 고정된 S/D 를 가정한다.
;;  이걸 리세스+에피 구조로 바꾸려면:
;;    1. 원본의 S/D cuboid 정의를 찾는다 (보통 "Source"/"Drain" 이름의
;;       sdegeo:create-cuboid 또는 sdegeo:create-polyhedron 호출).
;;    2. 그 영역을 게이트 옆 표면에서 아래로 RECESS 만큼 파낸 모양으로
;;       바꾼다 (S/D 상단면 z 좌표를 -RECESS 로).
;;    3. RECESS 를 Workbench 스윕 변수로 뺀다:
;;         (define RECESS (/ @Recess_nm@ 1000.0))   ; [um]
;;       ※ 정확한 cuboid/boolean 함수 호출 문법은 원본 예제에서 그대로
;;         가져와 좌표만 바꿀 것 — 새로 지어내지 말 것.
;; =====================================================================
(define RECESS  (/ @Recess_nm@ 1000.0))   ; ★스윕 Y — 리세스 깊이 [um]

;; =====================================================================
;;  TODO-EPI : 파낸 자리에 SiGe 를 선택적 에피택시로 채우기
;;
;;    1. TODO-RECESS 에서 파낸 자리를 재질 "SiGe"(또는 설치된 Sentaurus
;;       버전의 재질 데이터베이스에 등록된 정확한 이름 — 예: Silicon1-xGex
;;       형태로 조성을 별도 지정해야 할 수도 있음, User Guide 확인 필요)로
;;       채운다.
;;    2. Ge 조성은 Workbench 스윕 변수로 뺀다. Workbench 파라미터 자체는
;;       params.yaml/run_id 표기와 맞춰 "퍼센트"(20~40) 로 등록하고,
;;       재질 함수에 넘길 때만 몰분율(0~1)로 내부 변환한다:
;;         (define GE_FRAC  (/ @GePercent@ 100.0))   ; ★스윕 X — Ge 몰분율 (0~1)
;;       재질 지정 시 조성을 인자로 받는 정확한 문법은 설치 버전 SDE User
;;       Guide 의 "Alloy Materials" 또는 "Compound Semiconductor" 관련 장
;;       참고 (미확인 — Phase 0 에서 확인 필요, docs/technical-notes.md
;;       4절 항목 3 과 연결: Stress 섹션 소성완화 모델 유무 확인할 때
;;       같이 확인할 것).
;;    3. S/D 붕소 도핑은 baseline/params.yaml 의 sd_boron_conc_cm3 값을
;;       그대로 가져다 쓴다 (지어내지 말 것 — 그 필드도 아직 PLACEHOLDER).
;; =====================================================================
(define GE_FRAC  (/ @GePercent@ 100.0))   ; ★스윕 X — Ge 몰분율 (0~1). Workbench 파라미터는 %(20~40) 단위

